{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Enforce Hover Constructor",
  "scopeName": "source.enforce.hover.constructor",
  "patterns": [
    {
      "include": "source.enforce.hover#comments"
    },
    {
      "include": "source.enforce.hover#strings"
    },
    {
      "include": "source.enforce.hover#preprocessor"
    },
    {
      "include": "#constructor-identifiers"
    },
    {
      "include": "source.enforce.hover#function-kind"
    },
    {
      "include": "source.enforce.hover#function-identifiers"
    },
    {
      "include": "source.enforce.hover#primitive-keywords"
    },
    {
      "include": "source.enforce.hover#generic-type-parameters"
    },
    {
      "include": "source.enforce.hover#type-identifiers"
    },
    {
      "include": "source.enforce.hover#grammar-keywords"
    },
    {
      "include": "source.enforce.hover#numbers"
    },
    {
      "include": "source.enforce.hover#punctuation"
    },
    {
      "include": "source.enforce.hover#identifiers"
    }
  ],
  "repository": {
    "constructor-identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.class.enforce.hover",
          "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
        }
      ]
    }
  }
}
