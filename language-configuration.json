{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "autoClosingPairs": [
    {
      "open": "/*",
      "close": "*/",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "autoCloseBefore": ";:.,=+-*/%&|^!~? \t\n",
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:else\\s+)?if\\s*\\([^{};]*\\)|else)\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "previousLineText": "^\\s*(?:(?:else\\s+)?if\\s*\\([^{};]*\\)|else)\\s*$",
      "beforeText": "^(?!\\s*(?://|/\\*|\\*))\\s*\\S.*$",
      "action": {
        "indent": "outdent"
      }
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ]
}
