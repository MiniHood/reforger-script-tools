{
  "$schema": "vscode://schemas/color-theme",
  "name": "Reforger Enforce Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#40b5ac",
    "enum": "#40b5ac",
    "enumMember": "#cfcfcf",
    "function": "#f3ad58",
    "method": "#f3ad58",
    "variable": "#cfcfcf",
    "field": "#cfcfcf",
    "parameter": "#cfcfcf",
    "type": "#40b5ac",
    "typeParameter": "#40b5ac",
    "keyword": "#59A6E9",
    "comment": "#59aa59",
    "string": "#c178dd",
    "number": "#cfcfcf",
    "operator": "#bfbfbf",
    "punctuation": "#bfbfbf",
    "preprocessor": "#d4fd95",
    "decorator": "#d4fd95"
  }
}
