{
  "name": "reforger-sript-tools",
  "displayName": "Reforger Sript Tools",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "enforce",
        "aliases": [
          "Enforce",
          "Enfusion Script"
        ],
        "filenamePatterns": [
          "**/Scripts/**/*.c",
          "**/scripts/**/*.c"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "themes": [
      {
        "label": "Reforger Enforce Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/reforger-enforce-dark-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "reforger-sript-tools.debug.hoverAtCursor",
        "title": "Reforger Script Tools: Debug Hover At Cursor"
      },
      {
        "command": "reforger-sript-tools.gameData.checkForUpdates",
        "title": "Reforger Script Tools: Check Game Data Updates"
      },
      {
        "command": "reforger-sript-tools.gameData.openStorageFolder",
        "title": "Reforger Script Tools: Open Game Data Storage Folder"
      }
    ],
    "configuration": {
      "title": "Reforger Script Tools",
      "properties": {
        "reforgerScriptTools.gameData.manualFolder": {
          "type": "string",
          "default": "",
          "description": "Optional manual Reforger game data folder. Set this to either the folder containing scripts/ or the scripts/ folder itself. When set, GitHub game-data checks and downloads are skipped."
        }
      }
    },
    "keybindings": [
      {
        "command": "reforger-sript-tools.debug.hoverAtCursor",
        "key": "ctrl+f1",
        "when": "editorTextFocus && editorLangId == enforce"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node tools/build-language-server.mjs && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node tools/build-language-server.mjs --release && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "build-server": "node tools/build-language-server.mjs",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "vscode-languageclient": "^10.1.0"
  }
}
