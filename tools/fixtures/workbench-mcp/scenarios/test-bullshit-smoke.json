{
  "name": "test-bullshit-read-only-smoke",
  "iterations": 3,
  "warmup": 1,
  "steps": [
    {"name":"status","tool":"workbench_status","arguments":{},"expect":{"pointers":{"/result/structuredContent/isRunning":true}}},
    {"name":"state","tool":"workbench_state","arguments":{},"expect":{"pointers":{"/result/structuredContent/mode":"world-editor","/result/structuredContent/activeWorldPath":"$fixture.worldResource"}}},
    {"name":"project-context","tool":"workbench_project_context","arguments":{},"expect":{"contains":{"/result/structuredContent/loadedAddons":["ArmaReforger","TestBullshit"]}}},
    {"name":"inspect-world-resource","tool":"workbench_inspect_resource","arguments":{"resourceName":"{DD49A6CE18710A05}worlds/test/empty_test.ent"},"expect":{"isError":true,"error":{"code":"workbench_protocol_error","phase":"inspect_resource"}}},
    {"name":"list-world-resources","tool":"workbench_list_resources","arguments":{"kinds":["world"],"query":"empty_test","limit":20}},
    {"name":"search-world-resources","tool":"workbench_search_resources","arguments":{"kinds":["world"],"query":"empty_test","limit":20},"expect":{"pointers":{"/result/structuredContent/results/0/logicalPath":"worlds/test/empty_test.ent"}}},
    {"name":"selection-summary","tool":"workbench_world_selection_summary","arguments":{}},
    {"name":"list-entities","tool":"workbench_list_entities","arguments":{"limit":20}},
    {"name":"inspect-world-root","tool":"workbench_inspect_entity","arguments":{"entityId":"0x0000000000000001 {}"},"expect":{"pointers":{"/result/structuredContent/entity/className":"GenericWorldEntity"}}},
    {"name":"list-world-root-components","tool":"workbench_list_components","arguments":{"entityId":"0x0000000000000001 {}"},"expect":{"pointers":{"/result/structuredContent/status":"available"}}},
    {"name":"list-world-root-properties","tool":"workbench_list_entity_properties","arguments":{"entityId":"0x0000000000000001 {}"},"expect":{"pointers":{"/result/structuredContent/status":"available"}}},
    {"name":"selected-entity-hierarchy","tool":"workbench_selected_entity_hierarchy","arguments":{"selectionIndex":0}},
    {"name":"search-world","tool":"workbench_search_world_entities","arguments":{"query":"","limit":5},"expect":{"pointers":{"/result/structuredContent/status":"available"}}},
    {"name":"find-near-origin","tool":"workbench_find_entities_by_radius","arguments":{"center":{"x":0,"y":0,"z":0},"radiusMeters":10,"limit":5,"queryScope":"all"},"expect":{"pointers":{"/result/structuredContent/status":"available"}}},
    {"name":"sample-terrain","tool":"workbench_sample_terrain","arguments":{"x":0,"z":0,"halfExtentMeters":1,"spacingMeters":1},"expect":{"pointers":{"/result/structuredContent/status":"available"}}},
    {"name":"viewport-context","tool":"workbench_get_viewport_context","arguments":{"includeRay":false}},
    {"name":"trace-origin","tool":"workbench_trace","arguments":{"start":{"x":0,"y":10,"z":0},"end":{"x":0,"y":-10,"z":0},"shape":"line","entities":true,"terrain":true,"ocean":false},"expect":{"pointers":{"/result/structuredContent/status":"available"}}},
    {"name":"active-layer","tool":"workbench_layer_state","arguments":{"subScene":1,"layerId":0}},
    {"name":"list-editors","tool":"workbench_list_editors","arguments":{},"expect":{"pointers":{"/result/structuredContent/editors/0/displayName":"World Editor"}}},
    {"name":"open-world-editor","tool":"workbench_open_editor","arguments":{"editorId":"world"},"expect":{"pointers":{"/result/structuredContent/opened":true}}},
    {"name":"open-world","tool":"workbench_open_resource","arguments":{"resourcePath":"$fixture.worldResource"},"expect":{"pointers":{"/result/structuredContent/opened":true}}},
    {"name":"validate-scripts","tool":"workbench_validate_scripts","arguments":{"limit":20}},
    {"name":"install-bridge","tool":"workbench_install_bridge","arguments":{},"expect":{"pointers":{"/result/structuredContent/installedVersion":"1.52.12"}}},
    {"name":"read-integration-log","tool":"workbench_read_logs","arguments":{"source":"integration","lineCount":20},"expect":{"pointers":{"/result/structuredContent/source":"integration"}}},
    {"name":"reuse-launched-workbench","tool":"workbench_launch","arguments":{"projectPath":"$fixture.projectPath"},"expect":{"pointers":{"/result/structuredContent/alreadyRunning":true,"/result/structuredContent/netApiConnected":true}}},
    {"name":"reject-unknown-stop-process","tool":"workbench_stop","arguments":{"processId":0},"expect":{"isError":true,"error":{"code":"workbench_unavailable","phase":"stop"}}},
    {"name":"reject-unknown-restart-process","tool":"workbench_restart","arguments":{"processId":0},"expect":{"isError":true,"error":{"code":"workbench_unavailable","phase":"restart"}}}
  ]
}
